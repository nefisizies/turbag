generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  password         String
  role             Role
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  acenteProfile    AcenteProfile?
  bildirimler      Bildirim[]
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  rehberProfile    RehberProfile?
  receivedReviews  Review[]       @relation("ReceivedReviews")
  givenReviews     Review[]       @relation("GivenReviews")
}

model RehberProfile {
  id                 String                  @id @default(cuid())
  userId             String                  @unique
  slug               String                  @unique
  name               String
  bio                String?
  city               String?
  photoUrl           String?
  specialties        String[]
  experienceYears    Int                     @default(0)
  isAvailable        Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  operatingCountries String[]                @default([])
  telefon            String?
  unvan              UnvanTip                @default(YENI_REHBER)
  checkInSayisi      Int                     @default(0)
  benzersizSehir     Int                     @default(0)
  aktifAySayisi      Int                     @default(0)
  bloklar            AcenteRehberBlok[]
  referanslar        Referans[]
  languages          RehberDil[]
  licenses           RehberLicense[]
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  takvimEtkinlikleri TakvimEtkinlik[]
  tours              Tour[]
  acenteEtkinlikleri AcenteTakvimEtkinlik[]
  checkInler         CheckIn[]
  rozetler           RehberRozet[]
}

model RehberDil {
  id        String        @id @default(cuid())
  rehberId  String
  dil       String
  seviye    String?
  sertifika String?
  sonuc     String?
  createdAt DateTime      @default(now())
  rehber    RehberProfile @relation(fields: [rehberId], references: [id], onDelete: Cascade)

  @@unique([rehberId, dil])
}

model RehberLicense {
  id          String        @id @default(cuid())
  rehberId    String
  country     String
  licenseType String
  licenseNo   String
  status      LicenseStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  rehber      RehberProfile @relation(fields: [rehberId], references: [id], onDelete: Cascade)
}

model AcenteProfile {
  id             String                  @id @default(cuid())
  userId         String                  @unique
  slug           String                  @unique
  companyName    String
  description    String?
  city           String?
  logoUrl        String?
  website        String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloklar        AcenteRehberBlok[]
  referanslar    Referans[]
  etkinlikler    AcenteTakvimEtkinlik[]
  turProgramlari TurProgrami[]
  ilanlar        Ilan[]
}

model TurProgrami {
  id          String                 @id @default(cuid())
  acenteId    String
  ad          String
  sure        Int
  // [{ lokasyon: string, gun: number }]
  segmentler  Json
  aktif       Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  acente      AcenteProfile          @relation(fields: [acenteId], references: [id], onDelete: Cascade)
  etkinlikler AcenteTakvimEtkinlik[]
  turistler   TuristKayit[]
}

model TuristKayit {
  id          String      @id @default(cuid())
  programId   String
  ad          String
  soyad       String
  pasaportNo  String?
  uyruk       String?
  dogumTarihi String?
  telefon     String?
  eposta      String?
  notlar      String?
  ekAlanlar   Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  program     TurProgrami @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model AcenteRehberBlok {
  id        String        @id @default(cuid())
  acenteId  String
  rehberId  String
  tur       BlokTur
  banBitis  DateTime?
  createdAt DateTime      @default(now())
  acente    AcenteProfile @relation(fields: [acenteId], references: [id], onDelete: Cascade)
  rehber    RehberProfile @relation(fields: [rehberId], references: [id], onDelete: Cascade)

  @@unique([acenteId, rehberId])
}

model Referans {
  id        String        @id @default(cuid())
  rehberId  String
  acenteId  String
  durum     ReferansDurum @default(BEKLIYOR)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  acente    AcenteProfile @relation(fields: [acenteId], references: [id], onDelete: Cascade)
  rehber    RehberProfile @relation(fields: [rehberId], references: [id], onDelete: Cascade)

  @@unique([rehberId, acenteId])
}

model Tour {
  id          String        @id @default(cuid())
  rehberId    String
  title       String
  description String?
  duration    String?
  location    String?
  priceRange  String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  rehber      RehberProfile @relation(fields: [rehberId], references: [id], onDelete: Cascade)
}

model Bildirim {
  id        String      @id @default(cuid())
  userId    String
  tip       BildirimTip
  baslik    String
  metin     String?
  link      String?
  okundu    Boolean     @default(false)
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TakvimEtkinlik {
  id                 String                @id @default(cuid())
  rehberId           String
  baslik             String
  baslangic          DateTime
  bitis              DateTime?
  notlar             String?
  tur                EtkinlikTur           @default(MANUEL)
  acenteEtkinlikId   String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  rehber             RehberProfile         @relation(fields: [rehberId], references: [id], onDelete: Cascade)
  acenteEtkinlik     AcenteTakvimEtkinlik? @relation(fields: [acenteEtkinlikId], references: [id], onDelete: SetNull)
}

model AcenteTakvimEtkinlik {
  id          String            @id @default(cuid())
  acenteId    String
  baslik      String
  baslangic   DateTime
  bitis       DateTime?
  lokasyon    String?
  rehberId    String?
  programId   String?
  notlar      String?
  rehberYanit RehberYanitDurum?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  acente      AcenteProfile     @relation(fields: [acenteId], references: [id], onDelete: Cascade)
  rehber      RehberProfile?    @relation(fields: [rehberId], references: [id], onDelete: SetNull)
  program     TurProgrami?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  turistler   EtkinlikTurist[]
  rehberKopya TakvimEtkinlik[]
}

model EtkinlikTurist {
  id          String               @id @default(cuid())
  etkinlikId  String
  ad          String
  soyad       String
  pasaportNo  String?
  uyruk       String?
  dogumTarihi String?
  telefon     String?
  eposta      String?
  notlar      String?
  ekAlanlar   Json?
  createdAt   DateTime             @default(now())
  etkinlik    AcenteTakvimEtkinlik @relation(fields: [etkinlikId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  from       User     @relation("SentMessages", fields: [fromUserId], references: [id])
  to         User     @relation("ReceivedMessages", fields: [toUserId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  reviewee   User     @relation("ReceivedReviews", fields: [revieweeId], references: [id])
  reviewer   User     @relation("GivenReviews", fields: [reviewerId], references: [id])
}

model CheckIn {
  id          String        @id @default(cuid())
  rehberId    String
  baslik      String
  aciklama    String?
  fotografUrl String?
  sehir       String?
  ulke        String?
  lat         Float?
  lng         Float?
  dogrulandi  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  rehber      RehberProfile @relation(fields: [rehberId], references: [id], onDelete: Cascade)
}

model Rozet {
  id         String        @id @default(cuid())
  kod        String        @unique
  baslik     String
  aciklama   String?
  ikon       String
  kategori   String
  kazananlar RehberRozet[]
}

model RehberRozet {
  id          String        @id @default(cuid())
  rehberId    String
  rozetId     String
  kazanildiAt DateTime      @default(now())
  onaylandi   Boolean       @default(false)
  rehber      RehberProfile @relation(fields: [rehberId], references: [id], onDelete: Cascade)
  rozet       Rozet         @relation(fields: [rozetId], references: [id], onDelete: Cascade)

  @@unique([rehberId, rozetId])
}

enum Role {
  REHBER
  ACENTE
  ADMIN
}

enum LicenseStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ReferansDurum {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
  KALDIRILDI
}

enum EtkinlikTur {
  MANUEL
  REZERVASYON
}

enum BlokTur {
  GECICI
  KALICI
}

enum BildirimTip {
  MESAJ
  REFERANS
  SISTEM
  DAVET
}

enum RehberYanitDurum {
  BEKLIYOR
  KABUL
  RED
}

enum UnvanTip {
  YENI_REHBER
  AKTIF_REHBER
  DENEYIMLI_REHBER
  UZMAN_REHBER
  SUPER_REHBER
  ELIT_REHBER
}

model Ilan {
  id         String        @id @default(cuid())
  acenteId   String
  baslik     String
  aciklama   String?
  sehir      String?
  tarih      DateTime?
  sure       String?
  ucret      String?
  diller     String[]      @default([])
  aktif      Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  acente     AcenteProfile @relation(fields: [acenteId], references: [id], onDelete: Cascade)
}
